+            || ch == QChar::ParagraphSeparator
+            || ch == QChar::LineSeparator) {
+            ++row;
+            lineStart = i + 1;
+        }
+    }
+
+    return TSPoint{
+        row,
+        static_cast<uint32_t>(qMax(0, clamped - lineStart) * 2)
+    };
+}
